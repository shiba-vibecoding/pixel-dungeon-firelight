{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pd-coop",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Players outside Telegram (a plain browser) may join rooms as guests.
    "ALLOW_GUESTS": "true"
  },
  // The bot token is a secret: npx wrangler secret put BOT_TOKEN
  "observability": { "enabled": true }
}
