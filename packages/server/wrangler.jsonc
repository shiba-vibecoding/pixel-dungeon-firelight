{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pd-coop",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DAILY", "class_name": "DailyBoard" },
      { "name": "WALLET", "class_name": "WalletStore" },
      { "name": "REPORTS", "class_name": "ReportStore" },
      { "name": "PLAYER", "class_name": "Player" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["DailyBoard"] },
    { "tag": "v3", "new_sqlite_classes": ["WalletStore"] },
    { "tag": "v4", "new_sqlite_classes": ["ReportStore"] },
    { "tag": "v5", "new_sqlite_classes": ["Player"] }
  ],
  "vars": {
    // Players outside Telegram (a plain browser) may join rooms as guests.
    "ALLOW_GUESTS": "true",
    // The Mini App's t.me link: the bot's play button.
    "APP_LINK": "https://t.me/pixel_dungeon_gamebot/pixel_dungeon",
    // The terms page the bot's /terms points to (the client's public/terms.html).
    "TERMS_URL": "https://shiba-vibecoding.github.io/pixel-dungeon-telegram/terms.html"
    // Optional: "ADMIN_CHAT_ID": "<your Telegram user id, or a group's id>". Messages players write to the bot
    // (after /paysupport) are passed on to that chat, and only there do /refund, /payments and /reply work.
    // Without it the bot tells players to write to the contact in payments.ts.
  },
  // Secrets: npx wrangler secret put BOT_TOKEN, and WEBHOOK_SECRET for the bot's webhook (/telegram/webhook);
  // REPORT_KEY reads the error reports back (scripts/reports.mjs).
  // Logs: what the server itself logs (console.error) is kept; Cloudflare's invocation logs are off, because
  // they record each request's URL, and a room's WebSocket URL carries the player's Telegram init data.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
